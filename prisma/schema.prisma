// Noveleiras de Plantao - modelo de dados da Fase 01.
// Modelado para que o painel administrativo da Fase 02 nasca observavel:
// todo evento relevante cai em `Event` (log append-only) e as tabelas
// consultadas em tempo real ficam normalizadas ao lado.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- contas

enum Role {
  USER
  EDITOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  handle       String     @unique
  avatarSeed   String     @default("1")
  avatarKey    String?
  googleSubject String?   @unique
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)

  // Permissoes granulares do painel. `Role` decide quem entra; esta lista
  // decide o que a pessoa alcanca la dentro. Lista de strings em vez de tabela
  // de RBAC: no volume desta operacao a tabela seria complexidade sem retorno,
  // e migrar para ela depois nao quebra nenhuma tela.
  // Catalogo tipado em `lib/painel/permissoes.ts`.
  permissions String[] @default([])

  // Conta criada pelo seed de demonstracao. O painel usa isto para separar
  // dado de vitrine de dado real, em vez de misturar os dois.
  isDemo Boolean @default(false)

  onboardedAt DateTime?
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  preference   Preference?
  subscription Subscription?
  sessions     AppSession[]
  progress     WatchProgress[]
  favorites    Favorite[]
  searches     SearchQuery[]
  events       Event[]
  posts        Post[]
  postLikes    PostLike[]
  comments     Comment[]

  episodeLikes        EpisodeLike[]
  episodeComments     EpisodeComment[]
  episodeCommentLikes EpisodeCommentLike[]

  entitlements       Entitlement[]
  purchases          Purchase[]
  paymentAttempts    PaymentAttempt[]
  refunds            Refund[]
  subscriptionEvents SubscriptionEvent[]

  @@index([createdAt])
  @@index([lastSeenAt])
}

model Preference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  favoriteGenreIds String[] @default([])
  autoplayNext     Boolean  @default(true)
  dataSaver        Boolean  @default(false)
  reduceMotion     Boolean  @default(false)
  spoilerGuard     Boolean  @default(true)
  notifyReleases   Boolean  @default(true)
  notifyCommunity  Boolean  @default(true)
  preferredQuality String   @default("auto")

  updatedAt DateTime @updatedAt
}

// -------------------------------------------------------- assinatura

enum SubscriptionPlan {
  FREE
  MONTHLY
  ANNUAL

  // Nomes da Fase 01. Postgres nao renomeia nem remove valor de enum sem
  // trocar o tipo inteiro, e as assinaturas gravadas ainda os referenciam.
  // Ficam como historico; `lib/pagamentos/planos.ts` mapeia os antigos.
  PREMIUM
  VIP
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

/**
 * Como um ciclo vira o proximo.
 *
 * AUTO_RENEW    o provedor cobra sozinho no fim do ciclo (preapproval, no
 *               cartao). Quem renova e ele; nos so registramos.
 * MANUAL_RENEW  nao existe cobranca automatica: cada ciclo nasce de um
 *               pagamento que a pessoa faz de novo, por vontade propria. E o
 *               caso do Pix, que nao tem debito automatico.
 *
 * Deliberadamente **nao** e o meio de pagamento. Meio de pagamento ja mora em
 * `Payment.method` e `PaymentAttempt.method`; o que muda aqui e a semantica da
 * renovacao — quem tem a iniciativa, o que acontece no vencimento, e o que
 * "cancelar" significa. Derivar isso de `method == "pix"` amarraria as duas
 * coisas e quebraria no dia em que outro meio manual aparecer.
 */
enum BillingMode {
  AUTO_RENEW
  MANUAL_RENEW
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   SubscriptionPlan   @default(FREE)
  status SubscriptionStatus @default(ACTIVE)

  // Toda assinatura gravada antes do Pix mensal renova sozinha no cartao, e o
  // default diz isso: nenhuma linha existente muda de comportamento.
  billingMode BillingMode @default(AUTO_RENEW)

  // Preparado para um provedor de pagamento real sem migracao adicional.
  provider           String?
  externalCustomerId String?
  externalId         String?
  priceCents         Int?
  trialEndsAt        DateTime?
  startedAt          DateTime  @default(now())
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?
  updatedAt          DateTime  @updatedAt

  // Assinatura recorrente no provedor (preapproval, no Mercado Pago). Guardado
  // separado de `externalId` porque a cobranca de um ciclo e a assinatura que
  // a gerou sao objetos diferentes do lado deles.
  externalPreapprovalId String?

  // Ciclo atual. `currentPeriodEnd` sozinho nao diz desde quando vale, e sem
  // isso um reembolso nao sabe qual ciclo esta desfazendo.
  currentPeriodStart DateTime?

  // Falha de cobranca: quantos ciclos seguidos falharam e ate quando a
  // tolerancia (grace period) mantem o acesso de pe.
  failedCharges Int       @default(0)
  graceUntil    DateTime?

  entitlements Entitlement[]
  attempts     PaymentAttempt[]
  events       SubscriptionEvent[]
  refunds      Refund[]

  @@index([plan, status])
  @@index([status, currentPeriodEnd])
  @@index([externalPreapprovalId])
  // A varredura do Pix pergunta "quem renova a mao e esta perto de vencer?".
  @@index([billingMode, status, currentPeriodEnd])
}

// ------------------------------------------------ sessoes e dispositivos

model AppSession {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  deviceId   String
  platform   String  @default("web")
  osName     String?
  browser    String?
  screenW    Int?
  screenH    Int?
  standalone Boolean @default(false)
  userAgent  String?
  language   String?
  timezone   String?
  referrer   String?

  startedAt   DateTime  @default(now())
  lastBeatAt  DateTime  @default(now())
  endedAt     DateTime?
  durationMs  Int       @default(0)
  screenViews Int       @default(0)
  watchedMs   Int       @default(0)

  events Event[]

  @@index([userId, startedAt])
  @@index([deviceId])
  @@index([startedAt])
}

// ------------------------------------------------------------- catalogo

enum AccessTier {
  FREE
  PREMIUM
}

enum NovelaStatus {
  ONGOING
  COMPLETED
  COMING_SOON
}

model Genre {
  id      String @id @default(cuid())
  slug    String @unique
  name    String
  tagline String
  accent  String
  sort    Int    @default(0)

  novelas NovelaGenre[]
}

model Novela {
  id       String @id @default(cuid())
  slug     String @unique
  title    String
  tagline  String
  synopsis String

  status NovelaStatus @default(ONGOING)

  // Legado da Fase 01. Nao decide mais acesso: a regra oficial passou a ser
  // "os N primeiros episodios de qualquer novela sao gratuitos". Mantido
  // porque as linhas gravadas o referenciam e o painel ainda o exibe.
  accessTier AccessTier @default(FREE)

  // Libera a obra inteira, de proposito, para quem nao assina.
  //
  // Campo novo em vez de reaproveitar `accessTier`: toda novela gravada esta
  // como FREE, entao reusar aquele campo abriria o catalogo inteiro no exato
  // dia em que o paywall entrasse em vigor — o oposto do pretendido.
  openAccess Boolean @default(false)

  // Preco da compra avulsa quando esta obra foge da tabela.
  priceCents Int?
  ageRating  String @default("14")
  year       Int
  country    String @default("Brasil")

  // Arte: chaves opacas resolvidas pela camada de midia.
  posterKey  String
  heroKey    String
  accent     String  @default("#B3325A")
  trailerKey String?

  editorialNote String?
  isFeatured    Boolean @default(false)

  // Texto normalizado (sem acento, minusculo) com titulo, sinopse, elenco e
  // tags: e o que a busca compara. Preenchido no seed/ingestao.
  searchText String @default("")

  featuredRank Int?

  cast        Json     @default("[]")
  tags        String[] @default([])
  rating      Float    @default(0)
  ratingCount Int      @default(0)

  // Contadores denormalizados: mantem "populares" barato e alimenta o painel.
  viewCount     Int    @default(0)
  favoriteCount Int    @default(0)
  watchedMs     BigInt @default(0)

  releasedAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  genres    NovelaGenre[]
  seasons   Season[]
  episodes  Episode[]
  favorites Favorite[]
  progress  WatchProgress[]
  posts     Post[]

  entitlements Entitlement[]
  purchases    Purchase[]

  @@index([status, releasedAt])
  @@index([viewCount])
  @@index([isFeatured, featuredRank])
}

model NovelaGenre {
  novelaId String
  genreId  String
  novela   Novela @relation(fields: [novelaId], references: [id], onDelete: Cascade)
  genre    Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([novelaId, genreId])
  @@index([genreId])
}

model Season {
  id       String @id @default(cuid())
  novelaId String
  novela   Novela @relation(fields: [novelaId], references: [id], onDelete: Cascade)

  number   Int
  title    String
  synopsis String?

  episodes Episode[]

  @@unique([novelaId, number])
}

enum MediaProvider {
  LOCAL
  RAILWAY
  OBJECT_STORE
  CDN
  EXTERNAL
}

model Episode {
  id       String @id @default(cuid())
  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  novelaId String
  novela   Novela @relation(fields: [novelaId], references: [id], onDelete: Cascade)

  number   Int
  title    String
  synopsis String

  durationSec Int
  accessTier  AccessTier @default(FREE)
  isBonus     Boolean    @default(false)

  // A origem do video nunca e uma URL: e chave + provedor, resolvidos em runtime.
  mediaKey      String
  mediaProvider MediaProvider @default(LOCAL)
  mediaFormat   String        @default("mp4")
  thumbKey      String

  releasedAt DateTime
  viewCount  Int      @default(0)
  watchedMs  BigInt   @default(0)
  createdAt  DateTime @default(now())

  // Contadores sociais do reel. Denormalizados pelo mesmo motivo dos de
  // `Novela`: a lamina precisa exibir o numero no primeiro quadro, e contar
  // linha a linha numa fila de dezenas de episodios custaria uma consulta por
  // lamina. A fonte factual continua sendo `EpisodeLike`/`EpisodeComment`.
  likeCount  Int @default(0)
  shareCount Int @default(0)

  // Legado. Nao e mais lido nem escrito: a contagem de comentarios passou a
  // sair de `_count` sobre a relacao.
  //
  // O motivo e concreto. Comentario agora tem resposta, e apagar uma raiz
  // remove a arvore inteira em cascata — um decremento de 1 deixaria o numero
  // permanentemente acima do fato. Ja custou duas rodadas de reconciliacao
  // neste projeto; contar a relacao torna a divergencia impossivel por
  // construcao. A coluna fica porque remove-la seria migracao destrutiva, e
  // nenhuma leitura depende dela.
  commentCount Int @default(0)

  // Gancho do reel: a frase que segura a pessoa nos primeiros segundos.
  // Vazio cai para a sinopse — a lamina nunca fica muda.
  hookText String?

  progress WatchProgress[]
  posts    Post[]
  likes    EpisodeLike[]
  comments EpisodeComment[]

  @@unique([seasonId, number])
  @@index([novelaId, number])
  @@index([releasedAt])
}

// -------------------------------------------------- social do episodio
//
// Curtida e comentario de episodio vivem em tabelas proprias, separadas de
// `PostLike` e `Comment`, por uma razao concreta: aquelas apontam para `Post`
// com chave obrigatoria. Torna-las polimorficas obrigaria a reescrever as
// leituras de `app/painel/comunidade`, `lib/painel/acoes/comunidade.ts` e
// `lib/painel/metricas/comunidade.ts` — as tres com dado gravado em producao.
//
// O preco desta escolha fica nomeado aqui: a moderacao do painel ainda nao
// enxerga estas linhas. `hiddenAt` ja existe e `ReportTargetType` ja aceita
// EPISODE_COMMENT, entao a tela de moderacao entra sem migracao destrutiva.

model EpisodeLike {
  episodeId String
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([episodeId, userId])
  @@index([userId, createdAt])
}

model EpisodeComment {
  id        String  @id @default(cuid())
  episodeId String
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  body    String
  spoiler Boolean @default(false)

  // Raiz da conversa. Nulo significa comentario de primeiro nivel.
  //
  // A arvore e achatada na escrita, nunca na leitura: responder a uma resposta
  // grava `parentId` da raiz, e nao do alvo. Sem essa regra a profundidade
  // cresceria sem limite e a interface — que desenha exatamente dois niveis,
  // como Instagram e TikTok — nao teria onde colocar o terceiro.
  parentId String?
  parent   EpisodeComment?  @relation("ThreadDeComentario", fields: [parentId], references: [id], onDelete: Cascade)
  replies  EpisodeComment[] @relation("ThreadDeComentario")

  // A quem esta resposta se dirige. Guardado como chave, e nao como "@fulano"
  // no corpo, para que trocar de nome nao deixe mencoes velhas espalhadas.
  // SetNull: apagar o alvo nao pode derrubar quem respondeu.
  replyToId String?
  replyTo   EpisodeComment?  @relation("RespostaDirigida", fields: [replyToId], references: [id], onDelete: SetNull)
  dirigidas EpisodeComment[] @relation("RespostaDirigida")

  likes EpisodeCommentLike[]

  createdAt DateTime  @default(now())
  // Ocultar uma raiz tira a conversa inteira de vista: as respostas continuam
  // gravadas, mas nao sao listadas nem contadas enquanto a raiz estiver oculta.
  hiddenAt  DateTime?

  @@index([episodeId, parentId, hiddenAt, createdAt])
  @@index([parentId, createdAt])
  @@index([userId, createdAt])
}

model EpisodeCommentLike {
  commentId String
  comment   EpisodeComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([commentId, userId])
  @@index([userId, createdAt])
}

// ------------------------------------------- progresso, lista, historico

model WatchProgress {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  episodeId String
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  novelaId  String
  novela    Novela  @relation(fields: [novelaId], references: [id], onDelete: Cascade)

  positionSec Int     @default(0)
  durationSec Int
  percent     Int     @default(0)
  completed   Boolean @default(false)

  // Tempo real de tela, nao apenas a posicao final: base para "tempo assistido".
  watchedMs   Int      @default(0)
  playCount   Int      @default(1)
  abandonedAt Int?
  firstPlayAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, episodeId])
  @@index([userId, updatedAt])
  @@index([userId, novelaId, updatedAt])
  @@index([novelaId])
}

model Favorite {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  novelaId String
  novela   Novela @relation(fields: [novelaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, novelaId])
  @@index([userId, createdAt])
  @@index([novelaId])
}

model SearchQuery {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  sessionId       String?
  term            String
  normalized      String
  resultCount     Int      @default(0)
  clickedNovelaId String?
  createdAt       DateTime @default(now())

  @@index([normalized])
  @@index([createdAt])
}

// ----------------------------------------------------- feed / comunidade

enum PostKind {
  THOUGHT
  REVIEW
  THEORY
}

model Post {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  novelaId  String?
  novela    Novela?  @relation(fields: [novelaId], references: [id], onDelete: SetNull)
  episodeId String?
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)

  kind    PostKind @default(THOUGHT)
  body    String
  spoiler Boolean  @default(false)
  rating  Int?

  likeCount    Int       @default(0)
  commentCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  hiddenAt     DateTime?

  likes    PostLike[]
  comments Comment[]

  @@index([createdAt])
  @@index([novelaId, createdAt])
}

model PostLike {
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@index([userId])
}

model Comment {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  body      String
  createdAt DateTime  @default(now())
  hiddenAt  DateTime?

  @@index([postId, createdAt])
}

// ----------------------------------------------------------- telemetria

enum EventType {
  SESSION_START
  SESSION_HEARTBEAT
  SESSION_END
  SCREEN_VIEW
  ONBOARDING_STEP
  ONBOARDING_COMPLETE
  SIGN_UP
  SIGN_IN
  SIGN_OUT
  NOVELA_VIEW
  EPISODE_VIEW
  PLAY_START
  PLAY_PROGRESS
  PLAY_PAUSE
  PLAY_SEEK
  PLAY_COMPLETE
  PLAY_ABANDON
  PLAY_ERROR
  SEARCH
  SEARCH_RESULT_CLICK
  CATEGORY_OPEN
  FAVORITE_ADD
  FAVORITE_REMOVE
  FEED_VIEW
  POST_CREATE
  POST_LIKE
  POST_COMMENT

  // Reel. REEL_SLIDE_VIEW so e emitido depois do limiar de permanencia: sem
  // isso, uma passada de dedo por dez laminas viraria dez "visualizacoes" e
  // envenenaria retencao, abandono e "continue assistindo" de uma vez.
  REEL_OPEN
  REEL_SLIDE_VIEW
  REEL_SLIDE_SKIP
  EPISODE_LIKE
  EPISODE_UNLIKE
  EPISODE_COMMENT
  EPISODE_SHARE
  PAYWALL_VIEW
  PAYWALL_CTA

  // Funil comercial. Separados de PAYWALL_CTA porque a pergunta que importa
  // nao e "clicou?" e sim onde a pessoa parou: abriu o checkout e sumiu,
  // teve o cartao recusado, ou pagou.
  CHECKOUT_START
  CHECKOUT_APPROVED
  CHECKOUT_REJECTED
  PURCHASE_COMPLETE
  SUBSCRIPTION_CANCEL

  PREFERENCES_UPDATE
  PWA_INSTALLED
  CLIENT_ERROR
}

// Log append-only. Todas as visoes do painel (retencao, abandono, buscas,
// engajamento, novelas mais acessadas) derivam daqui + WatchProgress.
model Event {
  id     String    @id @default(cuid())
  type   EventType
  userId String?
  user   User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  sessionId String?
  session   AppSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  entityType String?
  entityId   String?
  novelaId   String?
  episodeId  String?

  valueMs  Int?
  payload  Json    @default("{}")
  path     String?
  platform String?
  deviceId String?

  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@index([novelaId, createdAt])
  // O drill-down novela -> temporada -> episodio consulta por episodio.
  @@index([episodeId, createdAt])
  @@index([createdAt])
}

// ==========================================================================
// FASE 02 — o que o painel administrativo precisa e a Fase 01 nao modelou.
//
// Separacao proposital: `Event` e telemetria de produto (o que a pessoa fez);
// `AppLog` e log de aplicacao (o que o sistema fez); `AdminAudit` e prova de
// autoria (o que um administrador fez). Conflatar os tres tornaria qualquer
// investigacao um garimpo.
// ==========================================================================

// -------------------------------------------------------------- auditoria

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

model AdminAudit {
  id String @id @default(cuid())

  actorId    String
  actorEmail String
  actorName  String

  action      String // ex.: "catalogo.novela.atualizar"
  targetType  String // ex.: "Novela"
  targetId    String?
  targetLabel String?

  // Estado antes e depois, para reconstruir o que aconteceu.
  before Json?
  after  Json?

  // Acoes destrutivas ficam marcadas para filtro rapido.
  severity  AuditSeverity @default(INFO)
  ip        String?
  userAgent String?
  context   Json          @default("{}")

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}

// ------------------------------------------------------------------- logs

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}

enum LogChannel {
  APP
  SERVER
  STREAMING
  MEDIA
  AUTH
  PAYMENTS
  JOBS
  INTEGRATIONS
  ADMIN
}

model AppLog {
  id      String     @id @default(cuid())
  level   LogLevel   @default(INFO)
  channel LogChannel @default(APP)

  message       String
  // Correlaciona linhas de canais diferentes que pertencem ao mesmo problema.
  correlationId String?

  userId     String?
  entityType String?
  entityId   String?
  path       String?
  stack      String?
  context    Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([level, createdAt])
  @@index([channel, createdAt])
  @@index([correlationId])
}

// ---------------------------------------------------------------- alertas

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model Alert {
  id   String @id @default(cuid())
  kind String // ex.: "servidor.offline", "disco.baixo"

  severity AlertSeverity @default(WARNING)
  status   AlertStatus   @default(OPEN)

  title     String
  detail    String?
  // Chave de deduplicacao: o mesmo problema reabrindo nao vira ruido novo.
  dedupeKey String  @unique

  entityType String?
  entityId   String?
  context    Json    @default("{}")

  occurrences Int      @default(1)
  openedAt    DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt     DateTime?
  resolvedBy     String?
  resolvedNote   String?

  @@index([status, severity, lastSeenAt])
  @@index([openedAt])
}

// ------------------------------------------------------- servidor de midia

enum MediaServerStatus {
  UNKNOWN
  ONLINE
  DEGRADED
  OFFLINE
}

/**
 * Um servidor de midia registrado. Plural desde o comeco: hoje e o computador
 * de casa, amanha podem ser varios nos ou uma origem em nuvem, e a tela ja
 * lista em vez de assumir um.
 */
model MediaServer {
  id   String @id @default(cuid())
  slug String @unique
  name String
  kind String @default("LOCAL") // LOCAL | REMOTE | CLOUD

  // Endereco de controle (opcional: um servidor pode so enviar batimentos).
  baseUrl   String?
  // Hash do segredo compartilhado que autentica os batimentos do agente.
  tokenHash String?

  status       MediaServerStatus @default(UNKNOWN)
  lastBeatAt   DateTime?
  uptimeSec    Int?
  agentVersion String?
  notes        String?

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  beats     MediaServerBeat[]
  assets    MediaAsset[]
  libraries MediaLibrary[]
  scans     LibraryScan[]

  @@index([status])
}

// ------------------------------------------------------------ biblioteca

/**
 * Uma pasta de conteudo declarada pela operacao.
 * A diferenca estrutural em relacao a um servidor de midia tradicional: aqui
 * quem tem o disco nao e quem roda a aplicacao. O painel **declara** a
 * biblioteca (nome, caminho, regras); o agente na maquina do disco a
 * **varre**; o servidor **importa** o resultado. Por isso `path` e um caminho
 * na maquina do agente, e nao algo que a aplicacao consiga abrir.
 * Plural desde o comeco pelo mesmo motivo dos servidores: uma pasta hoje,
 * varias amanha, sem reescrever tela.
 */
model MediaLibrary {
  id   String @id @default(cuid())
  name String
  // Caminho na maquina do agente. A aplicacao nunca o abre.
  path String

  serverId String?
  server   MediaServer? @relation(fields: [serverId], references: [id], onDelete: SetNull)

  enabled         Boolean @default(true)
  // Criar novela/temporada/episodio a partir das pastas, ou so inventariar
  // arquivos. Quem so quer conferir integridade desliga isto.
  autoImport      Boolean @default(true)
  // Novelas criadas por esta biblioteca nascem publicadas ou em rascunho.
  publishOnImport Boolean @default(false)

  lastScanAt    DateTime?
  lastScanState String?
  // Contagens da ultima varredura, para a tela nao precisar reagregar.
  lastNovelas   Int       @default(0)
  lastEpisodes  Int       @default(0)
  lastFiles     Int       @default(0)
  lastBytes     BigInt    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scans LibraryScan[]

  @@unique([serverId, path])
  @@index([enabled])
}

enum ScanState {
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELED
}

/**
 * Uma varredura pedida pelo painel e executada pelo agente.
 * Existe como linha para que a operacao veja o progresso enquanto acontece e
 * o historico depois. Uma varredura que so aparece no terminal de quem a
 * rodou nao e observavel.
 */
model LibraryScan {
  id        String       @id @default(cuid())
  libraryId String
  library   MediaLibrary @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  serverId String?
  server   MediaServer? @relation(fields: [serverId], references: [id], onDelete: SetNull)

  state          ScanState @default(QUEUED)
  // Etapa corrente em palavras: "varrendo", "lendo metadados", "importando".
  phase          String?
  // Progresso bruto; a tela deriva o percentual.
  totalFiles     Int       @default(0)
  processedFiles Int       @default(0)

  // O que a varredura produziu.
  // Novelas que a arvore trouxe, importadas ou nao: com `autoImport` desligado
  // as duas contagens abaixo ficam zeradas e esta continua sendo a verdadeira.
  novelasSeen     Int    @default(0)
  novelasCreated  Int    @default(0)
  novelasUpdated  Int    @default(0)
  episodesCreated Int    @default(0)
  episodesUpdated Int    @default(0)
  filesIndexed    Int    @default(0)
  filesMissing    Int    @default(0)
  bytesTotal      BigInt @default(0)
  // Arquivos que nao casaram com o padrao de nome, para alguem olhar.
  warnings        Json   @default("[]")

  error       String?
  requestedBy String?
  // Varredura completa relê metadados e checksum de tudo.
  full        Boolean @default(false)

  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  // Ultimo sinal de vida. E por ele que uma varredura vira abandonada, e nao
  // por `startedAt`: a entrega leva dezenas de requisicoes agora, e uma
  // varredura que comecou ha muito tempo continua viva enquanto reporta.
  updatedAt  DateTime  @default(now()) @updatedAt

  @@index([state, queuedAt])
  @@index([libraryId, queuedAt])
}

/**
 * Serie temporal de saude. Uma linha por batimento; o painel le a ultima para
 * o estado e a janela para os graficos.
 */
model MediaServerBeat {
  id       String      @id @default(cuid())
  serverId String
  server   MediaServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  cpuPercent  Float?
  ramUsedMb   Int?
  ramTotalMb  Int?
  gpuPercent  Float?
  vramUsedMb  Int?
  vramTotalMb Int?

  diskUsedGb  Float?
  diskTotalGb Float?

  netUpKbps   Float?
  netDownKbps Float?

  activeStreams Int    @default(0)
  transcodes    Int    @default(0)
  queueDepth    Int    @default(0)
  uptimeSec     Int?
  loadAvg       Float?

  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([serverId, createdAt])
}

// ---------------------------------------------------------------- midia

enum MediaAssetState {
  DISCOVERED
  READY
  PROCESSING
  MISSING
  BROKEN
  DUPLICATE
}

/**
 * Um arquivo fisico. Fica ao lado de `Episode`, nunca dentro: um episodio pode
 * ter varias versoes (1080p, 720p, HLS) e um arquivo pode existir sem episodio
 * associado — que e exatamente o problema que a tela de midia serve para ver.
 */
model MediaAsset {
  id String @id @default(cuid())

  serverId String?
  server   MediaServer? @relation(fields: [serverId], references: [id], onDelete: SetNull)

  // Mesma chave opaca do resolvedor: o painel nunca guarda URL.
  mediaKey String
  provider MediaProvider @default(LOCAL)
  path     String?

  episodeId String?
  // Rotulo da versao: "original", "1080p", "720p", "hls".
  variant   String  @default("original")
  isPrimary Boolean @default(true)

  sizeBytes   BigInt?
  durationSec Float?
  width       Int?
  height      Int?
  codecVideo  String?
  codecAudio  String?
  bitrateKbps Int?
  frameRate   Float?
  container   String?
  checksum    String?

  state        MediaAssetState @default(DISCOVERED)
  stateNote    String?
  lastProbedAt DateTime?

  /**
   * Ultima varredura de biblioteca que carimbou este arquivo.
   * E o que permite a arvore chegar em lotes. Sem ele, "sumiu do disco" seria
   * "nao veio neste envio", e o primeiro lote marcaria como ausente tudo o que
   * ainda estava por vir. Com ele, ausente e o que a varredura inteira nao
   * carimbou — a mesma pergunta de antes, feita depois do ultimo lote.
   * Nao reaproveita `lastProbedAt`: aquele campo tambem e escrito pelo
   * inventario avulso, e um inventario rodando no meio de uma varredura
   * apagaria a diferenca entre visto e ausente.
   */
  lastScanId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs TranscodeJob[]

  @@unique([mediaKey, variant])
  @@index([episodeId])
  @@index([state])
  @@index([checksum])
  // A reconciliacao pergunta exatamente isto: o que este servidor tem que a
  // varredura corrente nao carimbou.
  @@index([serverId, lastScanId])
}

// ------------------------------------------------------- transcodificacao

enum TranscodeState {
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELED
}

model TranscodeJob {
  id String @id @default(cuid())

  assetId String?
  asset   MediaAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  serverId  String?
  episodeId String?

  // Perfil de saida pedido: "1080p", "720p", "hls".
  profile String
  state   TranscodeState @default(QUEUED)

  progress Float   @default(0) // 0..100
  speed    Float? // multiplicador de tempo real (ex.: 3.2x)
  etaSec   Int?
  fps      Float?
  gpuUsed  Boolean @default(false)

  inputKey  String?
  outputKey String?
  outputs   Json    @default("[]")

  error    String?
  attempts Int     @default(0)
  priority Int     @default(0)

  requestedBy String?
  queuedAt    DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  @@index([state, priority, queuedAt])
  @@index([episodeId])
}

// ------------------------------------------------------------- financeiro

enum PaymentKind {
  SUBSCRIPTION
  TITLE_PURCHASE
}

enum PaymentStatus {
  PENDING
  APPROVED
  FAILED
  REFUNDED
  CHARGEBACK
}

/**
 * Um movimento financeiro. Existe separado de `Subscription` porque receita e
 * um fato datado — sem isto, "receita do mes" so poderia ser estimada a partir
 * do estado atual da assinatura, que e justamente o tipo de metrica inventada
 * que esta fase se recusa a mostrar.
 */
model Payment {
  id     String @id @default(cuid())
  userId String

  subscriptionId String?

  // Nulo numa compra avulsa: ela nao pertence a plano nenhum.
  //
  // Era `@default(PREMIUM)` e nao-nulo, o que fazia toda venda de novela
  // entrar no relatorio como se fosse assinatura — e o painel nao teria como
  // separar R$ 4,99 de titulo de R$ 9,99 de mensalidade.
  plan SubscriptionPlan?

  // O que foi vendido. Uma coluna explicita, em vez de inferir de `plan` ser
  // nulo: relatorio que depende de inferencia envelhece mal.
  kind PaymentKind @default(SUBSCRIPTION)

  // Como esta cobranca renovava. Nulo em compra avulsa e nas cobrancas
  // anteriores ao Pix mensal — que eram todas recorrentes por cartao.
  //
  // Existe para o relatorio: "quantas renovacoes Pix houve em setembro" nao se
  // responde por `method`, porque um dia o Pix pode ser usado noutro fluxo, e
  // nao se responde pelo estado atual da assinatura, porque ele so conhece o
  // hoje. Receita e fato datado; o modo de cobranca do dia tambem.
  billingMode BillingMode?

  amountCents Int
  currency    String        @default("BRL")
  status      PaymentStatus @default(APPROVED)

  provider       String? // "demo" enquanto nao ha gateway real
  externalId     String?
  method         String?
  failureCode    String?
  failureMessage String?

  refundedCents Int       @default(0)
  periodStart   DateTime?
  periodEnd     DateTime?

  // Assinatura: qual ciclo esta cobranca pagou. Nulo em compra avulsa, em
  // cobranca recusada e em cobranca de um preapproval que ja nao e o vigente
  // — nenhuma dessas concede ciclo.
  //
  // Junto com `@@unique([provider, externalId])` fecha as duas direcoes do
  // principio que governa a renovacao: uma cobranca real concede no maximo um
  // ciclo, e um ciclo e pago por no maximo uma cobranca. As duas travas estao
  // no banco de proposito: reentrega e concorrencia nao respeitam `if`.
  cycleIndex Int?
  // Fatura (`authorized_payment`) do Mercado Pago. Uma fatura pode ter varias
  // cobrancas — as retentativas de um cartao recusado — e so a aprovada
  // concede o ciclo. E por aqui que uma recusa antiga reconhece que a mesma
  // fatura ja foi paga por uma retentativa posterior.
  invoiceId  String?

  // Marca dado de demonstracao: o painel separa receita real de receita fake.
  // O modo mock da fase comercial grava tudo com isto ligado.
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Compra avulsa que originou o movimento. Nulo quando e assinatura.
  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  // Tentativa que originou este pagamento: liga o que o usuario iniciou ao
  // que o provedor confirmou.
  //
  // Deliberadamente **nao** e unico. Uma assinatura recorrente nasce de uma
  // tentativa so e gera um pagamento por ciclo — com unicidade aqui, a
  // primeira renovacao violaria a constraint, a transacao do webhook cairia e
  // o provedor reentregaria em laco.
  attemptId String?
  attempt   PaymentAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  refunds Refund[]

  // Idempotencia do lado de ca: dois webhooks para a mesma cobranca nao podem
  // virar duas linhas de receita. Parcial (nulo permitido) porque os
  // pagamentos da Fase 01 nao tem referencia externa.
  @@unique([provider, externalId])
  // Um ciclo, uma cobranca. A outra metade do principio da renovacao.
  @@unique([subscriptionId, cycleIndex])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([purchaseId])
  @@index([attemptId])
  @@index([subscriptionId])
  @@index([invoiceId])
}

// -------------------------------------------------------------- moderacao

enum ReportTargetType {
  POST
  COMMENT
  USER
  EPISODE_COMMENT
}

enum ReportState {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model Report {
  id String @id @default(cuid())

  targetType ReportTargetType
  targetId   String

  reporterId String?
  reason     String
  detail     String?

  state      ReportState @default(OPEN)
  resolvedBy String?
  resolvedAt DateTime?
  resolution String?

  createdAt DateTime @default(now())

  @@index([state, createdAt])
  @@index([targetType, targetId])
}

// ============================================================ monetizacao
//
// A regra comercial inteira mora aqui. Tres decisoes estruturais explicam o
// formato:
//
// 1. **Entitlement e a fonte de verdade, nao a assinatura.** Perguntar "esta
//    pessoa pode ver este episodio?" nunca consulta status de cobranca. Um
//    reembolso revoga o direito; a linha financeira permanece como fato. Sem
//    essa separacao, "assinatura cancelada mas novela comprada continua
//    liberada" viraria um `if` espalhado por cada tela.
//
// 2. **Fatos financeiros sao imutaveis e datados.** `PaymentAttempt` registra
//    o que a pessoa tentou, `Payment` o que o provedor confirmou, `Refund` o
//    que voltou. Nada e sobrescrito — receita de um mes fechado nao muda
//    porque alguem cancelou hoje.
//
// 3. **Duplicidade e barrada pelo banco, nao pelo codigo.** `WebhookEvent`
//    tem chave unica por evento do provedor e `Entitlement` tem indices
//    unicos parciais (criados no `migration.sql`, que o Prisma nao expressa).
//    Um webhook reentregue esbarra numa constraint, nao numa condicao de
//    corrida entre dois processos.

enum PlanInterval {
  MONTH
  YEAR
}

/**
 * Catalogo de planos vendaveis.
 * Em tabela, e nao so em codigo, porque preco e periodo precisam ficar
 * gravados no momento da venda: mudar a tabela amanha nao pode reescrever
 * quanto alguem pagou ontem. `lib/pagamentos/planos.ts` mantem os valores de
 * referencia e o seed reconcilia.
 */
model Plan {
  id   String           @id @default(cuid())
  code SubscriptionPlan @unique

  name          String
  description   String
  priceCents    Int
  currency      String       @default("BRL")
  interval      PlanInterval
  // Quantos `interval` cada ciclo dura. Anual = 1 YEAR; um futuro trimestral
  // seria 3 MONTH, sem enum novo.
  intervalCount Int          @default(1)

  entitlementKind EntitlementKind
  active          Boolean         @default(true)
  sortOrder       Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

enum EntitlementKind {
  SUBSCRIPTION_MONTHLY
  SUBSCRIPTION_ANNUAL
  TITLE_PURCHASE
}

enum EntitlementStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum EntitlementSource {
  SUBSCRIPTION
  PURCHASE
  // Concedido a mao pelo painel (suporte, cortesia). Auditavel como o resto.
  MANUAL
  PROMO
}

/**
 * Um direito de acesso concreto.
 * `endsAt` nulo significa perpetuo — e o caso da compra avulsa, que segue
 * valendo para episodios publicados depois. A assinatura sempre carrega data
 * de fim; quem renova estende a linha, quem cancela deixa expirar.
 */
model Entitlement {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind   EntitlementKind
  status EntitlementStatus @default(ACTIVE)
  source EntitlementSource

  // Preenchido apenas em TITLE_PURCHASE.
  novelaId String?
  novela   Novela? @relation(fields: [novelaId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  startsAt DateTime  @default(now())
  endsAt   DateTime?

  revokedAt DateTime?
  // Por que foi revogado ou concedido a mao. Vira linha de auditoria no painel.
  reason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, novelaId, status])
  @@index([status, endsAt])
  @@index([subscriptionId])
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  REFUNDED
  CHARGEBACK
}

/**
 * Compra avulsa de uma novela. Paga uma vez, vale para sempre.
 */
model Purchase {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  novelaId String
  novela   Novela @relation(fields: [novelaId], references: [id], onDelete: Cascade)

  status      PurchaseStatus @default(PENDING)
  amountCents Int
  currency    String         @default("BRL")

  provider             String?
  externalId           String?
  // Preferencia/checkout criado no provedor antes de existir pagamento.
  externalPreferenceId String?
  method               String?

  // Chave que o cliente manda para que dois cliques no botao nao virem duas
  // cobrancas. Unica no banco: a segunda tentativa reencontra a primeira.
  idempotencyKey String @unique

  failureCode    String?
  failureMessage String?
  refundedCents  Int     @default(0)

  paidAt     DateTime?
  canceledAt DateTime?
  isDemo     Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entitlements Entitlement[]
  payments     Payment[]
  attempts     PaymentAttempt[]
  refunds      Refund[]

  @@unique([provider, externalId])
  @@index([userId, status])
  @@index([novelaId, status])
  @@index([status, createdAt])
}

enum PaymentAttemptKind {
  SUBSCRIPTION
  PURCHASE
}

enum PaymentAttemptStatus {
  CREATED
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  ERROR
}

/**
 * O que a pessoa tentou pagar.
 * Separado de `Payment` porque a maioria das tentativas nunca vira receita —
 * cartao recusado, Pix que expirou, aba fechada no meio. Jogar tudo em
 * `Payment` contaminaria qualquer soma de faturamento; jogar fora apagaria
 * exatamente o dado que explica por que a conversao caiu.
 */
model PaymentAttempt {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind   PaymentAttemptKind
  status PaymentAttemptStatus @default(CREATED)

  plan     SubscriptionPlan?
  novelaId String?

  /**
   * So em `kind = SUBSCRIPTION`: que tipo de assinatura este checkout abre.
   *
   * E o que decide para onde a reconciliacao manda o pagamento depois. Num
   * AUTO_RENEW, `externalId` guarda o **preapproval** e quem decide o ciclo e
   * o livro de faturas; num MANUAL_RENEW, `externalId` guarda o **pagamento**
   * em si, e o ciclo nasce dele. Mandar um para o caminho do outro devolve 404
   * — foi assim que a preferencia do Checkout Pro se perdeu uma vez.
   */
  billingMode BillingMode?

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  amountCents Int
  currency    String  @default("BRL")
  method      String?

  provider String
  /**
   * O recurso que **decide** o estado: o pagamento (`/v1/payments`) numa
   * compra, o preapproval numa assinatura. Nunca uma preferencia.
   *
   * Guardar a preferencia aqui foi a origem de um bug caro: reconsultar
   * `/v1/payments/<preferenceId>` devolve 404, a reconciliacao devolvia
   * "inexistente" e o acesso simplesmente nao era concedido, em silencio.
   */
  externalId String?
  /**
   * Checkout Pro: a preferencia criada antes de existir pagamento. E o unico
   * id que temos enquanto a pessoa ainda esta na tela deles, e o ponto de
   * partida para descobrir o pagamento real depois.
   */
  externalPreferenceId String?
  /**
   * Checkout Pro: o pedido que agrupa as tentativas de pagamento de uma
   * preferencia. E por ele que se chega ao `paymentId` sem depender de a
   * pessoa voltar pela `back_url`.
   */
  externalMerchantOrderId String?
  // Como o provedor descreveu o estado, cru. O enum acima e a nossa leitura;
  // isto e o que ele disse, para quando as duas divergirem.
  rawStatus  String?

  idempotencyKey String @unique

  failureCode    String?
  failureMessage String?

  // Para onde mandar a pessoa (checkout hospedado, QR do Pix).
  checkoutUrl String?
  pixQrCode   String?
  /**
   * PNG do QR em base64, como o provedor o devolve.
   *
   * Gravado, e nao so devolvido na resposta do checkout, porque quem fecha o
   * aplicativo e volta meia hora depois precisa reencontrar o mesmo QR. Gerar
   * outro seria criar uma segunda cobranca para alguem que ja tem uma aberta.
   */
  pixQrCodeBase64 String?
  expiresAt       DateTime?

  isDemo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@unique([provider, externalId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  // Reconciliar a partir de um webhook de `merchant_order` ou de um retorno
  // que so trouxe `preference_id` precisa achar a tentativa por esses ids.
  @@index([externalPreferenceId])
  @@index([externalMerchantOrderId])
  // A varredura do Pix procura tentativas de assinatura manual sem desfecho.
  @@index([kind, billingMode, status, createdAt])
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  // Evento legitimo que nao muda nada nosso (topico que nao tratamos).
  IGNORED
  FAILED
}

/**
 * Toda notificacao recebida de um provedor, valida ou nao.
 * A unicidade `(provider, eventId)` e o mecanismo de idempotencia: reentrega
 * esbarra no banco antes de qualquer efeito. Assinatura invalida tambem e
 * gravada — tentativa de forjar webhook e justamente o que se quer auditar
 * depois, e descartar em silencio apagaria a evidencia.
 */
model WebhookEvent {
  id       String @id @default(cuid())
  provider String

  // Identificador do evento no provedor. Quando ele nao manda um, derivamos
  // de forma estavel a partir de topico + recurso.
  eventId String
  topic   String
  action  String?

  signatureValid Boolean
  status         WebhookEventStatus @default(RECEIVED)

  // Recurso citado (id do pagamento, da assinatura) para reconsulta.
  resourceId String?

  // WEBHOOK ou IPN. Nulo nas linhas anteriores a essa distincao.
  format String?

  // Notificacao que nao passou pela validacao (assinatura invalida, IPN)
  // nunca ocupa a chave de idempotencia: grava `eventId` sintetico e unico, e
  // o id que ela *alegava* fica aqui. Assim uma tentativa recusada nao
  // bloqueia a reentrega valida do mesmo evento, e cada tentativa continua
  // sendo uma linha auditavel.
  claimedEventId String?

  // Presenca e forma dos cabecalhos de assinatura, origem do data.id e
  // live_mode. Nunca o valor de x-signature, v1, segredo ou token.
  diagnostics Json?

  payload          Json
  // O que o provedor respondeu quando reconsultamos. E isto, e nao o corpo do
  // webhook, que autoriza mudanca de estado.
  providerSnapshot Json?

  attempts    Int       @default(0)
  error       String?
  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, eventId])
  @@index([claimedEventId])
  @@index([status, createdAt])
  @@index([resourceId])
}

enum RefundKind {
  REFUND
  CHARGEBACK
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
}

/**
 * Dinheiro que voltou. Reembolso pedido por nos, chargeback imposto a nos.
 */
model Refund {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind   RefundKind   @default(REFUND)
  status RefundStatus @default(REQUESTED)

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  amountCents Int
  currency    String  @default("BRL")
  reason      String?

  provider   String?
  externalId String?

  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, externalId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum SubscriptionEventType {
  CREATED
  ACTIVATED
  RENEWED
  PAYMENT_FAILED
  PAST_DUE
  CANCEL_REQUESTED
  CANCELED
  EXPIRED
  REACTIVATED
  REFUNDED
  CHARGEBACK
}

/**
 * Historico da assinatura.
 * `Subscription.userId` e unico — uma linha por pessoa, sobrescrita a cada
 * mudanca. Sem esta tabela, "quando cancelou", "quantas vezes renovou" e
 * "quando a cobranca falhou" seriam perguntas sem resposta.
 */
model SubscriptionEvent {
  id String @id @default(cuid())

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type       SubscriptionEventType
  fromStatus SubscriptionStatus?
  toStatus   SubscriptionStatus?
  periodEnd  DateTime?

  payload Json @default("{}")

  createdAt DateTime @default(now())

  @@index([subscriptionId, createdAt])
  @@index([type, createdAt])
}
