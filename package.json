{
  "name": "noveleiras-de-plantao",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "prisma generate && next build",
    "start": "next start -p 3100",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node --env-file=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "midia:demo": "node --env-file=.env scripts/gerar-midia-demo.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "inspecionar": "node scripts/inspecionar.mjs",
    "icones": "node scripts/gerar-icones.mjs",
    "fluxo": "node scripts/fluxo.mjs",
    "auditar": "node scripts/auditar.mjs",
    "painel:previa": "node --env-file=.env scripts/painel-previa.ts",
    "admin": "node --env-file=.env scripts/admin.ts",
    "painel:reconciliar": "node --env-file=.env scripts/reconciliar-contadores.ts",
    "painel:inspecionar": "node --env-file=.env scripts/inspecionar-painel.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "hls.js": "^1.7.2",
    "jose": "^6.2.12",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "ffmpeg-static@5.3.0": true,
    "playwright@1.63.0": true
  }
}
